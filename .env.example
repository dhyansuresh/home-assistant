# Server-side settings only. Copy this file to the repository root as .env for local development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HOME_PILOT_HOUSEHOLD_ID=
VISION_SERVICE_URL=http://localhost:8001
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4096
# Set LLM_PROVIDER=gemini to use the existing Gemini adapter instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Set LLM_PROVIDER=ollama to use a local Ollama server; pull the model first.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3
# Optional. Defaults to <repository>/data/homepilot.sqlite3. Set an absolute,
# persistent path for a cloud deployment, e.g. /var/lib/homepilot/homepilot.sqlite3.
HOME_PILOT_DATABASE_PATH=
