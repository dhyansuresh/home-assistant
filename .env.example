# Server-side settings only. Copy this file to the repository root as .env for local development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HOME_PILOT_HOUSEHOLD_ID=
VISION_SERVICE_URL=http://localhost:8001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional. Defaults to <repository>/data/homepilot.sqlite3. Set an absolute,
# persistent path for a cloud deployment, e.g. /var/lib/homepilot/homepilot.sqlite3.
HOME_PILOT_DATABASE_PATH=
